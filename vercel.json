{
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/pipeline?phase=contractors",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/pipeline?phase=opportunities",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/pipeline?phase=fulfill",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/pipeline?phase=send",
      "schedule": "0 16 * * *"
    }
  ]
}
