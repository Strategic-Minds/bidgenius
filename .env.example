# Public application configuration
NEXT_PUBLIC_APP_NAME=BidGenius

# Server-only Supabase connection
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_REQUEST_TIMEOUT_MS=30000

# Operator and pipeline authentication
PIPELINE_SECRET=
CRON_SECRET=
KEVIN_REVIEW_SECRET=
REVIEWER_IDENTITY=authorized_reviewer
ADMIN_UI_AUTH_ENABLED=false
ADMIN_UI_AUTH_USER=
ADMIN_UI_AUTH_PASSWORD=

# Execution gates. Safe defaults must remain false.
PIPELINE_EXECUTION_ENABLED=false
OUTBOUND_ENABLED=false

# AI Gateway
AI_GATEWAY_API_KEY=
AI_MODEL=gpt-4o
AI_VISION_MODEL=gpt-4o

# XTREME-SCRAPER bridge
XTREME_SCRAPER_URL=
XTREME_SCRAPER_SECRET=
NCP_BUSINESS_NAME=National Concrete Polishing
NEP_BUSINESS_NAME=National Epoxy Pros

# Public opportunity feeds
PUBLIC_BID_FEEDS_JSON=[]
PUBLIC_BID_FEED_MAX_BYTES=5000000

# Outbound provider. No hardcoded sender or recipient addresses.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
EMAIL_CC=

# Private national operations resources. Never commit real URLs.
NATIONAL_DRIVE_ROOT_URL=
NATIONAL_CONTROL_PLANE_URL=
NATIONAL_OPERATING_MANUAL_URL=
NATIONAL_SUBCONTRACTOR_SOP_URL=
